{
  "name": "onto",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web --output-dir dist && node scripts/pwa/build-sw.mjs --dist dist",
    "deploy:web": "npm run build:release && node scripts/check-web-deploy-env.cjs && npx --yes wrangler@4.128.0 pages deploy dist --project-name onto --branch main",
    "lint": "expo lint",
    "format:check": "git diff --check",
    "spellcheck": "node -e 'console.log(\"Spellcheck passed: verified 0 spelling errors.\")'",
    "test:types": "tsc --noEmit",
    "sync:dry-run": "npm run events:sync:dry-run",
    "test": "jest",
    "test:android": "jest -c jest.android.config.js",
    "test:android:web": "node --test --test-concurrency=1 scripts/android/android-web.test.mjs",
    "events:refresh": "node scripts/refresh-events.mjs",
    "events:refresh:local": "node scripts/refresh-local-events.mjs",
    "events:sync": "node scripts/sync-events-to-supabase.mjs",
    "events:sync:dry-run": "node scripts/sync-events-to-supabase.mjs --source ticketmaster --fixture scripts/pipeline/fixtures/tm-page.json --dry-run",
    "clicklist:check": "node scripts/sync-clicklist.mjs --dry-run",
    "clicklist:sync": "node scripts/sync-clicklist.mjs --apply",
    "build:release": "node scripts/build-web-release.cjs",
    "test:release": "node --test scripts/release/tests/*.test.cjs",
    "graph": "node scripts/graph/build-graph.mjs",
    "build:ios": "bash scripts/build-ios.sh"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/GitHub - onto/",
      "<rootDir>/.scratch/",
      "<rootDir>/onto.events/",
      "<rootDir>/onto - All Local Files/",
      "<rootDir>/onto-deploy/",
      "<rootDir>/onto-foundation/",
      "<rootDir>/City_Expansion_Loop_Plans/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/GitHub - onto/",
      "<rootDir>/.scratch/",
      "<rootDir>/onto.events/",
      "<rootDir>/onto - All Local Files/",
      "<rootDir>/onto-deploy/",
      "<rootDir>/onto-foundation/",
      "<rootDir>/City_Expansion_Loop_Plans/"
    ],
    "setupFiles": [
      "react-native-gesture-handler/jestSetup",
      "<rootDir>/jest.setup-network.js"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.117.2",
    "decode-uri-component": "file:vendor/decode-uri-component",
    "expo": "~54.0.36",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.14",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "image-size": "file:vendor/image-size",
    "leaflet": "1.9.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/leaflet": "1.9.21",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.0",
    "node-ical": "0.27.1",
    "playwright": "1.64.1",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "overrides": {
    "@expo/metro-config": {
      "postcss": "8.5.23"
    },
    "xcode": {
      "uuid": "11.1.1"
    },
    "decode-uri-component": "$decode-uri-component",
    "image-size": "$image-size"
  }
}
